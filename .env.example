# Application Environment Settings
# Options: development, testing, production
ENVIRONMENT=development

# Database Dialect Configurations
# SQLite default: sqlite:///database/db_sqlite.db
# PostgreSQL: postgresql://username:password@localhost:5432/database_name
# MySQL: mysql+pymysql://username:password@localhost:3306/database_name
DATABASE_URL=sqlite:///database/db_sqlite.db

# JWT Token Security Configurations
JWT_SECRET_KEY=yoursecretkey_superkey_for_jwt_auth_12345!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# MLOps Drift Retraining Parameters
RETRAIN_DRIFT_THRESHOLD=0.15

# Mock Alerts Configurations
ALERT_EMAIL_SENDER=soc-alerts@enterprise.com
ALERT_EMAIL_RECEIVER=soc-responders@enterprise.com
